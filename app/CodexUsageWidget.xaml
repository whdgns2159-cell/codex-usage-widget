<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Codex 사용량" Width="460" Height="432"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#0E1015" Foreground="#F5F7FA"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <sys:String x:Key="StatusLoading">Codex 사용량을 불러오는 중...</sys:String>
        <sys:String x:Key="StatusUpdated">실시간 연결됨 · {0}</sys:String>
        <sys:String x:Key="StatusError">연결 오류 · {0}</sys:String>
        <sys:String x:Key="StatusNoLogin">Codex 로그인이 필요합니다</sys:String>
        <sys:String x:Key="UsedFormat">{0}% 사용</sys:String>
        <sys:String x:Key="RemainingFormat">{0}% 남음</sys:String>
        <sys:String x:Key="ResetFormat">{0} 초기화</sys:String>
        <sys:String x:Key="ResetUnknown">초기화 시각 정보 없음</sys:String>
        <sys:String x:Key="LifetimeFormat">누적 토큰  {0}</sys:String>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#171A22"/>
            <Setter Property="BorderBrush" Value="#252A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,15"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="#7C5CFC"/>
            <Setter Property="Background" Value="#292E3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="8">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left" CornerRadius="4"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F5F7FA"/>
            <Setter Property="Background" Value="#7C5CFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#8C70FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#6547DD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#A7ADBA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Codex 사용량" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="Codex 사용량을 불러오는 중..."
                           Foreground="#8F96A5" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="10,5" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PlanText" Text="연결 중" FontSize="11" Foreground="#CBD5E1"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="5시간 한도" Foreground="#C8CDD7" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FiveRemainingText" Text="--% 남음" HorizontalAlignment="Right"
                               Foreground="#8F96A5" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock x:Name="FiveUsedText" Text="--% 사용" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="FiveResetText" Text="불러오는 중..." HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Foreground="#8F96A5" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="FiveProgress" Grid.Row="3" Minimum="0" Maximum="100" Value="0"/>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="주간 한도" Foreground="#C8CDD7" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WeekRemainingText" Text="--% 남음" HorizontalAlignment="Right"
                               Foreground="#8F96A5" FontSize="12"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,5,0,0">
                    <TextBlock x:Name="WeekUsedText" Text="--% 사용" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="WeekResetText" Text="불러오는 중..." HorizontalAlignment="Right"
                               VerticalAlignment="Bottom" Foreground="#8F96A5" FontSize="12"/>
                </Grid>
                <ProgressBar x:Name="WeekProgress" Grid.Row="3" Minimum="0" Maximum="100" Value="0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LifetimeText" Text="누적 토큰  --" Foreground="#8F96A5" FontSize="11"/>
                <CheckBox x:Name="AlwaysOnTopCheck" Content="항상 위" Margin="0,5,0,0" FontSize="11"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="지금 새로고침"/>
        </Grid>
    </Grid>
</Window>
